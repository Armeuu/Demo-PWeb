        },
        {
          "name": "14. POST Add Media to Collection (Happy Path 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Pesan sukses penambahan koleksi muncul\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Media berhasil ditambahkan ke dalam koleksi');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"media_id\": 2,\n  \"status\": \"Sedang Ditonton\",\n  \"catatan\": \"Episode 15, sangat berkesan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/1/collection",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1", "collection"]
            },
            "description": "Custom Action: Menambahkan media ke watchlist (relasi many-to-many attach)."
          }
        },
        {
          "name": "15. POST Add Duplicate Media to Collection (Failure Path 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Pesan error data duplikat muncul\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Media sudah ada di dalam koleksi pengguna');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"media_id\": 1,\n  \"status\": \"Sedang Ditonton\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/1/collection",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1", "collection"]
            },
            "description": "Pengujian pencegahan duplikasi relasi (Status 409 Conflict sesuai Modul Bab 4.6)."
          }
        },
