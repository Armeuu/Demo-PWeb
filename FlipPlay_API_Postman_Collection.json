{
  "info": {
    "_postman_id": "flipplay-rest-api-v1",
    "name": "FlipPlay REST API - Demo Modul 4",
    "description": "Koleksi Postman untuk Demo Praktikum Pemrograman Web Modul 4 - FlipPlay REST API (CRUD, Eloquent ORM, Relationships, Form Request Validation, API Resource, dan Error Handling).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Media (CRUD Standar)",
      "item": [
        {
          "name": "1. GET All Media (Happy Path 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Data response memiliki struktur API Resource\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/media",
              "host": ["{{base_url}}"],
              "path": ["api", "media"]
            },
            "description": "Mengambil seluruh katalog media dengan pagination dan relasi pengguna."
          }
        },
        {
          "name": "2. GET Search Media by Title (Happy Path 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Media ditemukan sesuai kata kunci 'Piece'\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.length).to.be.above(0);",
                  "    pm.expect(jsonData.data[0].judul).to.include('Piece');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/media?search=Piece",
              "host": ["{{base_url}}"],
              "path": ["api", "media"],
              "query": [
                { "key": "search", "value": "Piece" }
              ]
            },
            "description": "Pencarian judul media menggunakan Query Scope scopeSearch()."
          }
        },
        {
          "name": "3. GET Filter Media by Tipe (Happy Path 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Hanya mengembalikan media bertipe Anime\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.data.forEach(function(item) {",
                  "        pm.expect(item.tipe).to.eql('Anime');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/media?tipe=Anime",
              "host": ["{{base_url}}"],
              "path": ["api", "media"],
              "query": [
                { "key": "tipe", "value": "Anime" }
              ]
            },
            "description": "Filter media berdasarkan tipe menggunakan Query Scope scopeTipe()."
          }
        },
        {
          "name": "4. POST Create Media (Happy Path 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Data media berhasil dibuat\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.judul).to.eql('Solo Leveling');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Solo Leveling\",\n  \"tipe\": \"Anime\",\n  \"genre\": \"Action, Fantasy\",\n  \"rating\": 8.5,\n  \"tahun\": 2024,\n  \"status\": \"Airing\",\n  \"episode\": 12,\n  \"studio\": \"A-1 Pictures\",\n  \"deskripsi\": \"Sung Jinwoo pemburu terlemah menjadi hunter terkuat.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/media",
              "host": ["{{base_url}}"],
              "path": ["api", "media"]
            },
            "description": "Menambahkan media baru dengan HTTP Status 201 Created."
          }
        },
        {
          "name": "5. POST Create Media - Judul Kosong (Failure Path 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Validasi pesan error judul muncul\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.errors).to.have.property('judul');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipe\": \"Anime\",\n  \"tahun\": 2024\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/media",
              "host": ["{{base_url}}"],
              "path": ["api", "media"]
            },
            "description": "Pengujian validasi server-side Form Request ketika field wajib tidak diisi."
          }
        },
        {
          "name": "6. POST Create Media - Judul Duplikat (Failure Path 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Pesan error judul unik muncul\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.errors.judul[0]).to.include('sudah ada di katalog');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Attack on Titan\",\n  \"tipe\": \"Anime\",\n  \"tahun\": 2013\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/media",
              "host": ["{{base_url}}"],
              "path": ["api", "media"]
            },
            "description": "Pengujian validasi server-side rule unique:media,judul."
          }
        },
        {
          "name": "7. GET Media by ID (Happy Path 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Detail media & relasi pengguna termuat\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.eql(1);",
                  "    pm.expect(jsonData.data).to.have.property('pengguna_koleksi');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/media/1",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "1"]
            },
            "description": "Menampilkan detail satu media beserta relasi pengguna yang mengoleksinya (Eager Loading)."
          }
        },
        {
          "name": "8. GET Media by ID - Tidak Ditemukan (Failure Path 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/media/9999",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "9999"]
            },
            "description": "Pengujian Route Model Binding otomatis mengembalikan status 404 saat ID tidak ada."
          }
        },
        {
          "name": "9. PATCH Update Media (Happy Path 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Rating dan status berhasil diperbarui\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.rating).to.eql(9.5);",
                  "    pm.expect(jsonData.data.status).to.eql('Masterpiece');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 9.5,\n  \"status\": \"Masterpiece\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/media/1",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "1"]
            },
            "description": "Memperbarui sebagian data media menggunakan PATCH."
          }
        },
        {
          "name": "10. DELETE Media (Happy Path 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/media/5",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "5"]
            },
            "description": "Menghapus media dari katalog."
          }
        }
      ]
    },
